    <div class="wrap nav">
      <a href="#inicio" class="logo" aria-label="Grow Your Money">
        <img src="/img/icono.png" alt="" width="34" height="34">
      </a>
      <button class="burger" id="burger" aria-label="Abrir menú" aria-expanded="false">
        <svg class="ic" style="font-size:1.4rem"><use href="#i-plus" /></svg>
      </button>
      <div class="links" id="links">
        <a href="#nosotros">Quiénes somos</a>
        <a href="#roadmap">Cómo lo resolvemos</a>
        <a href="#productos">Productos</a>
        <a href="#testimonios">Testimonios</a>
        <a href="#faq">FAQ</a>
        <a class="btn sm" href="https://wa.me/549XXXXXXXXXX" target="_blank" rel="noopener">Contactar</a>
      </div>
    </div>
  </nav>

  <a class="wa" href="https://wa.me/549XXXXXXXXXX" target="_blank" rel="noopener"
    aria-label="Escribinos por WhatsApp"><svg class="ic"><use href="#i-wa" /></svg></a>

<script>
  const burger = document.getElementById('burger');
  const links = document.getElementById('links');

  if (burger && links) {
    burger.addEventListener('click', () => {
      const open = links.classList.toggle('open');
      burger.setAttribute('aria-expanded', String(open));
    });

    links.addEventListener('click', event => {
      const target = event.target as HTMLElement;
      if (target.tagName === 'A') links.classList.remove('open');
    });
  }
</script>

