<section id="roadmap">
    <div class="wrap">
      <div class="head rv">
        <h2>Tu camino hacia la <span class="lime">libertad financiera</span></h2>
      </div>

      <div class="road" id="road">
        <!-- Inicio del camino -->
        <article class="card pb rv">
          <svg class="ic" style="font-size:2rem;margin-bottom:10px"><use href="#i-bars" /></svg>
          <h3>Así empieza tu <span class="lime">camino</span></h3>
          <p style="margin:10px auto 0;max-width:560px">Conocé quiénes somos, qué te enseñamos y cómo convertimos las
            diferencias entre mercados en resultados.</p>
        </article>

        <!-- 1. Quiénes somos -->
        <article class="card step rv" id="nosotros">
          <span class="node">1</span>
          <svg class="ic"><use href="#i-users" /></svg>
          <h3>Quiénes somos</h3>
          <p>Somos una comunidad de personas que operan mercados internacionales todos los días. Texto de ejemplo: contá
            la historia, el equipo y la experiencia detrás de la marca.</p>
        </article>

        <!-- 2. Qué enseñamos -->
        <article class="card step rv">
          <span class="node">2</span>
          <svg class="ic"><use href="#i-book" /></svg>
          <h3>Qué enseñamos</h3>
          <p>Arbitraje, P2P, mesa OTC e intercambio de divisas, con método paso a paso. Texto de ejemplo: describí el
            programa, los formatos y el acompañamiento.</p>
        </article>

        <!-- 3. Qué problema resolvemos -->
        <article class="card step rv">
          <span class="node">3</span>
          <svg class="ic"><use href="#i-target" /></svg>
          <h3>Qué problema resolvemos</h3>
          <p>Tu dinero está quieto o se pierde en intermediarios. Texto de ejemplo: describí el dolor real del cliente, la
            inflación, las comisiones y la falta de acceso a mercados globales.</p>
        </article>

        <!-- 4. Lógica del negocio -->
        <article class="card step rv">
          <span class="node">4</span>
          <svg class="ic"><use href="#i-swap" /></svg>
          <h3>Lógica del negocio</h3>
          <p>Detectamos diferencias entre mercados, operamos P2P y OTC con contrapartes verificadas y capitalizamos el
            resultado. Texto de ejemplo: explicá el flujo real de una operación.</p>
        </article>
      </div>
    </div>
  </section>

<script>
  const road = document.getElementById('road');

  if (road) {
    const steps = [...road.querySelectorAll<HTMLElement>('.step')];
    const NS = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(NS, 'svg');
    const base = document.createElementNS(NS, 'path');
    const prog = document.createElementNS(NS, 'path');
    svg.setAttribute('class', 'rpath');
    svg.setAttribute('aria-hidden', 'true');
    base.setAttribute('class', 'pbase');
    prog.setAttribute('class', 'pprog');
    svg.append(base, prog);
    road.prepend(svg);

    let length = 0;
    let end = 1;

    function drawRoad() {
      const width = road.offsetWidth;
      const height = road.offsetHeight;
      const mobile = innerWidth <= 860;
      const intro = road.querySelector<HTMLElement>('.pb');
      if (!intro) return;

      const points: [number, number][] = [];

      points.push([mobile ? 18 : width / 2, intro.offsetTop + intro.offsetHeight]);
      steps.forEach(step => {
        const node = step.querySelector<HTMLElement>('.node');
        if (!node) return;
        points.push([
          step.offsetLeft + node.offsetLeft + node.offsetWidth / 2,
          step.offsetTop + node.offsetTop + node.offsetHeight / 2
        ]);
      });

      end = points[points.length - 1][1];
      let d = 'M' + points[0][0] + ' ' + points[0][1];

      for (let i = 1; i < points.length; i++) {
        const a = points[i - 1];
        const b = points[i];
        const dy = b[1] - a[1];
        const w = mobile ? (i % 2 ? 16 : -16) : 0;
        d += 'C' + (a[0] + w) + ' ' + (a[1] + dy * .4) + ' ' + (b[0] - w) + ' ' + (a[1] + dy * .6) + ' ' + b[0] + ' ' + b[1];
      }

      svg.setAttribute('viewBox', '0 0 ' + width + ' ' + height);
      svg.setAttribute('width', String(width));
      svg.setAttribute('height', String(height));
      base.setAttribute('d', d);
      prog.setAttribute('d', d);
      length = prog.getTotalLength();
      prog.style.strokeDasharray = String(length);
      roadScroll();
    }

    function roadScroll() {
      const rect = road.getBoundingClientRect();
      const viewport = innerHeight;
      const y = viewport * .6 - rect.top;
      if (length) prog.style.strokeDashoffset = String(length * (1 - Math.max(0, Math.min(1, y / end))));
      steps.forEach(step => {
        const box = step.getBoundingClientRect();
        step.classList.toggle('on', box.top + 30 < viewport * .6);
      });
    }

    addEventListener('scroll', roadScroll, { passive: true });
    addEventListener('resize', drawRoad);
    addEventListener('load', drawRoad);
    if (document.fonts) document.fonts.ready.then(drawRoad);
    drawRoad();
  }
</script>

<style>
  .road { position: relative; max-width: 940px; margin: 0 auto }

  .road > :global(.rpath) {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 0;
    pointer-events: none;
    overflow: visible
  }

  :global(.pbase) {
    fill: none;
    stroke: rgba(166, 250, 88, .25);
    stroke-width: 3;
    stroke-dasharray: 2 12;
    stroke-linecap: round
  }

  :global(.pprog) {
    fill: none;
    stroke: var(--lime);
    stroke-width: 3;
    stroke-linecap: round;
    filter: drop-shadow(0 0 6px var(--lime))
  }

  .road > * { position: relative; z-index: 1 }
  .pb { margin-bottom: 34px; text-align: center }
  .step { width: calc(50% - 90px); margin-bottom: 44px }
  .road > .step:last-of-type { margin-bottom: 0 }
  .step:nth-of-type(even) { margin-left: auto }

  .node {
    position: absolute;
    top: 24px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--line);
    display: grid;
    place-items: center;
    font-family: var(--fh);
    font-size: 1.2rem;
    color: var(--white);
    transition: .4s
  }

  .step:nth-of-type(odd) .node { left: calc(100% + 17px) }
  .step:nth-of-type(even) .node { right: calc(100% + 17px) }

  .step.on .node {
    background: var(--lime);
    color: #050505;
    border-color: var(--lime);
    box-shadow: 0 0 20px var(--lime)
  }

  .step .ic { font-size: 1.9rem; margin-bottom: 10px }
  .step h3 { margin-bottom: 8px }
  .step p { margin: 0; font-size: .92rem }

  @media (max-width: 860px) {
    .step { width: auto; margin-left: 56px !important; margin-bottom: 30px }
    .step:nth-of-type(n) .node { left: -56px; right: auto }
    .pb { text-align: left; margin-left: 56px }
  }
</style>
