<section id="roadmap">
  <div class="wrap">
    <div class="head rv">
      <h2>Tu camino hacia la <span class="lime">libertad financiera</span></h2>
    </div>

    <div class="road" id="road">
      <!-- 1. Quiénes somos (izquierda) -->
      <article class="card step rv" id="nosotros">
        <span class="node">1</span>
        <svg class="ic"><use href="#i-users" /></svg>
        <h3>Quiénes somos</h3>
        <p>Somos una comunidad de personas que operan mercados internacionales todos los días. Texto de ejemplo: contá
          la historia, el equipo y la experiencia detrás de la marca.</p>
      </article>

      <!-- 2. Qué enseñamos (derecha) -->
      <article class="card step rv">
        <span class="node">2</span>
        <svg class="ic"><use href="#i-book" /></svg>
        <h3>Qué enseñamos</h3>
        <p>Arbitraje, P2P, mesa OTC e intercambio de divisas, con método paso a paso. Texto de ejemplo: describí el
          programa, los formatos y el acompañamiento.</p>
      </article>

      <!-- 3. Qué problema resolvemos (izquierda) -->
      <article class="card step rv">
        <span class="node">3</span>
        <svg class="ic"><use href="#i-target" /></svg>
        <h3>Qué problema resolvemos</h3>
        <p>Tu dinero está quieto o se pierde en intermediarios. Texto de ejemplo: describí el dolor real del cliente, la
          inflación, las comisiones y la falta de acceso a mercados globales.</p>
      </article>

      <!-- 4. Lógica del negocio + resultados (derecha) -->
      <article class="card step rv">
        <span class="node">4</span>
        <svg class="ic"><use href="#i-swap" /></svg>
        <h3>Lógica del negocio + resultados</h3>
        <p>Detectamos diferencias entre mercados, operamos P2P y OTC con contrapartes verificadas y capitalizamos el
          resultado. Texto de ejemplo: explicá el flujo real de una operación.</p>
      </article>
    </div>
  </div>
</section>

<script>
  const road = document.getElementById('road');

  if (road) {
    const roadEl = road;
    const steps = [...roadEl.querySelectorAll<HTMLElement>('.step')];
    const NS = 'http://www.w3.org/2000/svg';
    const R = 18; // radio de las esquinas de las conexiones

    type Seg = { base: SVGPathElement; prog: SVGPathElement; len: number };

    const svg = document.createElementNS(NS, 'svg');
    svg.setAttribute('class', 'rpath');
    svg.setAttribute('aria-hidden', 'true');
    roadEl.prepend(svg);

    const segs: Seg[] = [];
    let triggers: number[] = [];

    function makeSeg(): Seg {
      const base = document.createElementNS(NS, 'path');
      const prog = document.createElementNS(NS, 'path');
      base.setAttribute('class', 'pbase');
      prog.setAttribute('class', 'pprog');
      svg.append(base, prog);
      return { base, prog, len: 0 };
    }

    const box = (el: HTMLElement) => ({
      l: el.offsetLeft,
      t: el.offsetTop,
      w: el.offsetWidth,
      h: el.offsetHeight,
      r: el.offsetLeft + el.offsetWidth,
      b: el.offsetTop + el.offsetHeight
    });

    // Recorrido ortogonal con esquina redondeada: horizontal hasta x1 y luego baja hasta y1
    function hv(x0: number, y0: number, x1: number, y1: number) {
      const s = x1 > x0 ? 1 : -1;
      return `M${x0} ${y0}L${x1 - s * R} ${y0}Q${x1} ${y0} ${x1} ${y0 + R}L${x1} ${y1}`;
    }

    function drawRoad() {
      const width = roadEl.offsetWidth;
      const height = roadEl.offsetHeight;
      const mobile = innerWidth <= 860;
      const b = steps.map(box);
      const defs: string[] = [];

      if (mobile) {
        // Camino recto por la izquierda, de nodo a nodo
        for (let i = 0; i < steps.length - 1; i++) {
          defs.push(`M18 ${b[i].t + 40}L18 ${b[i + 1].t + 40}`);
        }
        triggers = b.map(x => x.t + 40);
      } else {
        // 1 → 2: sale por la derecha de la card 1 (arriba) y baja a la card 2
        defs.push(hv(b[0].r, b[0].t + 30, b[1].l + b[1].w * .6, b[1].t));
        // 2 → 3: sale por la izquierda de la card 2 (abajo) y baja a la card 3
        defs.push(hv(b[1].l, b[1].b - 20, b[2].l + b[2].w * .35, b[2].t));
        // 3 → 4: sale por la derecha de la card 3 (arriba) y baja a la card 4
        defs.push(hv(b[2].r, b[2].t + 30, b[3].l + b[3].w * .3, b[3].t));
        // Las cards de la derecha están más abajo: se encienden un poco después
        triggers = [b[0].t + 40, b[1].t + 40 + 60, b[2].t + 40, b[3].t + 40 + 60];
      }

      svg.setAttribute('viewBox', '0 0 ' + width + ' ' + height);
      svg.setAttribute('width', String(width));
      svg.setAttribute('height', String(height));

      while (segs.length < defs.length) segs.push(makeSeg());
      defs.forEach((d, i) => {
        const s = segs[i];
        s.base.setAttribute('d', d);
        s.prog.setAttribute('d', d);
        s.len = s.prog.getTotalLength();
        s.prog.style.strokeDasharray = String(s.len);
      });
      roadScroll();
    }

    function roadScroll() {
      // "Línea de lectura" dentro del recorrido
      const line = innerHeight * .6 - roadEl.getBoundingClientRect().top;

      // Cada conexión se llena entre el encendido de su nodo de origen y el de su nodo de destino
      segs.forEach((s, i) => {
        const p = Math.max(0, Math.min(1, (line - triggers[i]) / (triggers[i + 1] - triggers[i])));
        s.prog.style.strokeDashoffset = String(s.len * (1 - p));
        s.prog.style.opacity = p > 0 ? '1' : '0';
      });
      // Cada nodo (card) se enciende cuando el recorrido llega a él
      steps.forEach((step, i) => step.classList.toggle('on', line >= triggers[i]));
    }

    addEventListener('scroll', roadScroll, { passive: true });
    addEventListener('resize', drawRoad);
    addEventListener('load', drawRoad);
    if (document.fonts) document.fonts.ready.then(drawRoad);
    drawRoad();
  }
</script>

<style>
  /* Contenedor más ancho para que las cards queden hacia los bordes */
  #roadmap .wrap { width: min(1320px, 94%); max-width: none }

  .road {
    --card: #0c100d;
    --muted: #9ba39a;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 460px) minmax(0, 460px);
    justify-content: space-between; /* izquierda pegada al borde izq., derecha al borde der. */
    column-gap: 80px;
    row-gap: 160px;
    align-items: start;
  }

  /* Orden: izquierda, derecha, izquierda, derecha. Las de la derecha van más abajo (boceto) */
  .step:nth-of-type(1) { grid-column: 1; grid-row: 1 }
  .step:nth-of-type(2) { grid-column: 2; grid-row: 1; margin-top: 110px }
  .step:nth-of-type(3) { grid-column: 1; grid-row: 2 }
  .step:nth-of-type(4) { grid-column: 2; grid-row: 2; margin-top: 110px }

  /* Conexiones (SVG generado por JS, por detrás de las cards) */
  .road > :global(.rpath) {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 0;
    pointer-events: none;
    overflow: visible
  }

  :global(.pbase) {
    fill: none;
    stroke: rgba(166, 250, 88, .22);
    stroke-width: 2.5;
    stroke-dasharray: 2 10;
    stroke-linecap: round
  }

  :global(.pprog) {
    fill: none;
    stroke: var(--lime);
    stroke-width: 3;
    stroke-linecap: round;
    stroke-linejoin: round;
    filter: drop-shadow(0 0 6px var(--lime))
  }

  /* Cards: opacas, así ocultan el tramo del camino que pasa por detrás */
  .step {
    position: relative;
    z-index: 1;
    background: linear-gradient(180deg, #0f1410, var(--card));
    border: 1.5px solid rgba(255, 255, 255, .14);
    border-radius: 22px;
    padding: 30px 28px;
    transition: border-color .5s, box-shadow .5s
  }

  .step h3 { margin: 0 0 8px }
  .step p { margin: 0; font-size: .95rem; color: var(--muted) }

  .step .ic {
    width: 34px;
    height: 34px;
    margin-bottom: 12px;
    color: rgba(166, 250, 88, .55);
    transition: color .5s, filter .5s
  }

  .node {
    position: absolute;
    top: -18px;
    left: 22px;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--line);
    display: grid;
    place-items: center;
    font-family: var(--fh);
    font-size: 1.2rem;
    color: var(--muted);
    transition: .5s
  }

  /* Encendido por scroll */
  .step.on {
    border-color: rgba(166, 250, 88, .55);
    box-shadow: 0 0 0 1px rgba(166, 250, 88, .12), 0 0 46px rgba(166, 250, 88, .08)
  }

  .step.on .ic { color: var(--lime); filter: drop-shadow(0 0 6px rgba(166, 250, 88, .6)) }

  .step.on .node {
    background: var(--lime);
    color: #050505;
    border-color: var(--lime);
    box-shadow: 0 0 20px var(--lime)
  }

  /* Mobile: una columna, camino por la izquierda */
  @media (max-width: 860px) {
    .road { grid-template-columns: minmax(0, 1fr); justify-content: stretch; row-gap: 64px }
    .step:nth-of-type(n) { grid-column: 1; grid-row: auto; margin: 0 0 0 56px }
    .node { top: 22px; left: -56px }
  }

  @media (prefers-reduced-motion: reduce) {
    .step, .node, .step .ic { transition: none }
  }
</style>