---
// Reemplazá video (y poster, opcional) por tus archivos reales.
const testimonios = [
  {
    video: "/video/juan.mp4",
    poster: undefined,
    texto: "Entré sin saber nada del tema y en pocas semanas ya estaba operando con confianza. El acompañamiento fue clave.",
    nombre: "Lucía",
    apellido: "Fernández",
  },
  {
    video: "/video/juan.mp4",
    poster: undefined,
    texto: "Lo que más valoro es la claridad: todo se explica paso a paso y sin vueltas. Lo recomiendo sin dudar.",
    nombre: "Martín",
    apellido: "Rodríguez",
  },
  {
    video: "/video/juan.mp4",
    poster: undefined,
    texto: "La comunidad es increíble. Siempre hay alguien dispuesto a ayudar y compartir lo que aprendió.",
    nombre: "Camila",
    apellido: "Gómez",
  },
  {
    video: "/video/juan.mp4",
    poster: undefined,
    texto: "Probé varias opciones antes y ninguna me dio los resultados que obtuve acá. Valió cada minuto.",
    nombre: "Joaquín",
    apellido: "Benítez",
  },
  {
    video: "/video/juan.mp4",
    poster: undefined,
    texto: "Me sentí acompañada desde el primer día. Hoy tengo herramientas que antes ni sabía que existían.",
    nombre: "Valentina",
    apellido: "Sosa",
  },
];
---

<section id="testimonios">
  <div class="wrap">
    <div class="head rv">
      <span class="eyebrow">Testimonios y eventos</span>
      <h2>Lo que dicen <span class="lime">nuestros alumnos</span></h2>
    </div>

    <div class="car rv">
      <div class="track" id="track">
        {
          testimonios.map((t) => (
            <article class="card t">
              <div class="vid">
                <video
                  src={t.video}
                  poster={t.poster}
                  preload="metadata"
                  playsinline
                />
                <button class="play" type="button" aria-label="Reproducir video">
                  <span>
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M6 4l14 8-14 8z" />
                    </svg>
                  </span>
                </button>
              </div>
              <div class="info">
                <p>“{t.texto}”</p>
                <b class="nombre">
                  {t.nombre} {t.apellido}
                </b>
              </div>
            </article>
          ))
        }
      </div>

      <div class="nav-c">
        <button id="prev" aria-label="Anterior">
          <svg class="ic"><use href="#i-left"></use></svg>
        </button>
        <button id="next" aria-label="Siguiente">
          <svg class="ic"><use href="#i-right"></use></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  const track = document.getElementById("track") as HTMLElement | null;
  const next = document.getElementById("next");
  const prev = document.getElementById("prev");

  if (track && next && prev) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>(".t"));

    const step = () => {
      const gap = parseFloat(getComputedStyle(track).columnGap) || 20;
      return (cards[0]?.offsetWidth ?? 0) + gap;
    };
    const atEnd = () => track.scrollLeft + track.clientWidth >= track.scrollWidth - 10;

    next.onclick = () => {
      if (atEnd()) track.scrollTo({ left: 0, behavior: "smooth" });
      else track.scrollBy({ left: step(), behavior: "smooth" });
    };

    prev.onclick = () => {
      track.scrollBy({ left: -step(), behavior: "smooth" });
    };

    // Video: un solo video a la vez
    const pauseAll = (except?: HTMLVideoElement) => {
      cards.forEach((c) => {
        const v = c.querySelector("video");
        if (v && v !== except) v.pause();
      });
    };

    cards.forEach((card) => {
      const v = card.querySelector("video") as HTMLVideoElement;
      const play = card.querySelector(".play") as HTMLButtonElement;

      play.addEventListener("click", () => {
        pauseAll(v);
        v.controls = true;
        v.play();
      });
      v.addEventListener("play", () => {
        pauseAll(v);
        card.classList.add("playing");
      });
      v.addEventListener("pause", () => card.classList.remove("playing"));
      v.addEventListener("ended", () => card.classList.remove("playing"));
    });

    // Pausa el video cuando su tarjeta sale de la vista
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) e.target.querySelector("video")?.pause();
        });
      },
      { root: track, threshold: 0.5 }
    );
    cards.forEach((c) => io.observe(c));
  }
</script>

<style>
  .car {
    position: relative;
  }

  .track {
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 6px 2px;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .t {
    flex: 0 0 calc((100% - 40px) / 3);
    scroll-snap-align: start;
    padding: 0;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  /* Video */
  .vid {
    position: relative;
    aspect-ratio: 4 / 5;
    background: #000;
  }

  .vid video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    border: 0;
    cursor: pointer;
    background: linear-gradient(to top, rgba(5, 5, 5, 0.6), transparent 55%);
    transition: opacity 0.2s;
  }

  .play span {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--lime);
    display: grid;
    place-items: center;
    transition: transform 0.2s;
  }

  .play:hover span {
    transform: scale(1.08);
  }

  .play svg {
    width: 22px;
    height: 22px;
    margin-left: 3px;
    fill: var(--bg);
  }

  .t.playing .play {
    opacity: 0;
    pointer-events: none;
  }

  /* Texto */
  .info {
    padding: 22px 22px 26px;
  }

  .info p {
    line-height: 1.6;
    color: var(--mute);
    font-size: 0.95rem;
  }

  .nombre {
    display: block;
    margin-top: 18px;
    font-family: var(--fh);
    font-weight: 400;
    font-size: 1.5rem;
    letter-spacing: 0.05em;
    color: var(--lime);
  }

  /* Navegación */
  .nav-c {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 22px;
  }

  .nav-c button {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid var(--line);
    color: var(--lime);
    cursor: pointer;
    display: grid;
    place-items: center;
    font-size: 1.1rem;
    transition: 0.2s;
  }

  .nav-c button:hover {
    background: var(--lime);
  }

  .nav-c button:hover .ic {
    stroke: var(--bg);
  }

  @media (max-width: 860px) {
    .t {
      flex-basis: 88%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .track {
      scroll-behavior: auto;
    }
  }
</style>